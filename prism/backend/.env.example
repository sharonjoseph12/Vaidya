# PRISM Backend Environment Variables
# Copy this file to prism/backend/.env and fill in your values.
# Settings always read prism/backend/.env (not cwd-relative). A second file (e.g. prism/.env)
# is ignored unless you export those variables into the shell before starting uvicorn.
# When this file exists, its values override shell / Windows User env (so ENCRYPTION_KEY here wins).

# Supabase (placeholder keys fail Supabase client init → in-memory mock DB for local UI/dev)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional: JSON path for file-backed Supabase mock state (default: prism/backend/.prism_mock_db.json).
# Lets multiple uvicorn workers share mock patients/sessions. Delete the file to reset mock data.
# PRISM_MOCK_DB_JSON=C:/temp/prism_mock_db.json

# Redis
REDIS_URL=redis://localhost:6379

# ABDM Sandbox
ABDM_CLIENT_ID=your-abdm-sandbox-client-id
ABDM_CLIENT_SECRET=your-abdm-sandbox-client-secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway

# Security — must be base64 of exactly 16, 24, or 32 bytes (AES-GCM). Use 32-byte AES-256:
#   openssl rand -base64 32
# Dev-only default below (do not use in production):
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Application
ENVIRONMENT=development
DEBUG=true

# Federated Learning
FL_SERVER_PORT=8080
FL_MIN_CLIENTS=2
FL_DP_EPSILON=1.0
FL_DP_DELTA=0.00001

# CORS
CORS_ORIGINS=["http://localhost:3000","https://prism-health.vercel.app"]

# Layer 1 — run real rPPG/audio/visual pipeline on uploaded scans (set false to force legacy mock)
USE_REAL_SENSE=true

# Pitch-deck only: if true, InferenceService returns static demo JSON on failure when id contains "demo"
ALLOW_DEMO_HARDCODE_FALLBACK=false
